PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/certihub
JWT_SECRET=replace_with_a_long_random_string_openssl_rand_hex_32
CLIENT_URL=http://localhost:5173
BACKUP_RETENTION=7

# Email configuration for nodemailer (optional)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@certihub.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (for server-side push notifications)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# Save it as: backend/config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
